@model KcetasWeb.ViewModels.YeniIsEmriViewModel
@{
    ViewData["Title"] = "Yeni İş Emri Oluştur";
}

<div class="mb-3">
    <a href="/IsEmri" class="btn btn-sm btn-outline-secondary">&larr; İş Emirleri Listesine Dön</a>
</div>

<div class="card shadow-sm border-0 mx-auto" style="max-width: 900px;">
    <div class="card-header bg-primary bg-opacity-10 border-0 py-3">
        <h5 class="mb-0 text-primary fw-bold"><i class="bi bi-plus-circle me-2"></i>Yeni İş Emri Oluştur</h5>
    </div>
    <div class="card-body p-4">
        <form asp-action="Yeni" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label asp-for="IsEmriNo" class="form-label fw-bold">İş Emri No</label>
                    <input asp-for="IsEmriNo" type="text" class="form-control bg-light text-muted" placeholder="Sistem Tarafından Otomatik Atanacak" readonly />
                </div>
                <div class="col-md-6">
                    <label asp-for="TuketimNoktasiId" class="form-label fw-bold">Tüketim Noktası (Abone) <span class="text-danger">*</span></label>
                    <select asp-for="TuketimNoktasiId" id="TuketimNoktasiId" class="form-select">
                        <option value="">TK kodu veya adres yazın...</option>
                        @if (Model.TuketimNoktasiId > 0 && ViewBag.SelectedTuketimNoktasiText != null)
                        {
                            <option value="@Model.TuketimNoktasiId" selected>@ViewBag.SelectedTuketimNoktasiText</option>
                        }
                    </select>
                    <span asp-validation-for="TuketimNoktasiId" class="text-danger small"></span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label asp-for="SozlesmeId" class="form-label fw-bold">Sözleşme Bilgisi</label>
                    <select asp-for="SozlesmeId" id="SozlesmeId" class="form-select">
                        <option value="">Sözleşme no veya TK kodu yazın...</option>
                        @if (Model.SozlesmeId.HasValue && Model.SozlesmeId.Value > 0 && ViewBag.SelectedSozlesmeText != null)
                        {
                            <option value="@Model.SozlesmeId.Value" selected>@ViewBag.SelectedSozlesmeText</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label asp-for="SayacId" class="form-label fw-bold">Sayaç Bilgisi</label>
                    <select asp-for="SayacId" id="SayacId" class="form-select">
                        <option value="">Sayaç seri no yazın...</option>
                        @if (Model.SayacId.HasValue && Model.SayacId.Value > 0 && ViewBag.SelectedSayacText != null)
                        {
                            <option value="@Model.SayacId.Value" selected>@ViewBag.SelectedSayacText</option>
                        }
                    </select>
                </div>
            </div>
            <div class="mb-4">
                <small id="secimMesaj" class="text-muted"></small>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label asp-for="Tip" class="form-label fw-bold">İş Emri Tipi <span class="text-danger">*</span></label>
                    <select data-control="select2" asp-for="Tip" class="form-select">
                        <option value="">-- Tip Seçiniz --</option>

                        <option value="@((int)KcetasWeb.Models.Enums.IsEmriTipi.Degistirme)">Sayaç Değiştirme</option>
                        <option value="@((int)KcetasWeb.Models.Enums.IsEmriTipi.Sokme)">Sayaç Sökme</option>
                        <option value="@((int)KcetasWeb.Models.Enums.IsEmriTipi.Kesme)">Enerji Kesme</option>
                        <option value="@((int)KcetasWeb.Models.Enums.IsEmriTipi.Acma)">Enerji Açma</option>
                        <option value="@((int)KcetasWeb.Models.Enums.IsEmriTipi.EndeksOkuma)">Endeks Okuma</option>
                        <option value="@((int)KcetasWeb.Models.Enums.IsEmriTipi.SayacAriza)">Sayaç Arıza</option>
                        <option value="@((int)KcetasWeb.Models.Enums.IsEmriTipi.Muhurleme)">Mühürleme</option>
                        <option value="@((int)KcetasWeb.Models.Enums.IsEmriTipi.KesifInceleme)">Keşif İnceleme</option>
                        <option value="@((int)KcetasWeb.Models.Enums.IsEmriTipi.YeniBaglanti)">Yeni Bağlantı</option>
                    </select>
                    <span asp-validation-for="Tip" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Oncelik" class="form-label fw-bold">Öncelik Durumu <span class="text-danger">*</span></label>
                    <select data-control="select2" asp-for="Oncelik" class="form-select">
                        <option value="Düşük">Düşük</option>
                        <option value="Normal" selected>Normal</option>
                        <option value="Yüksek">Yüksek</option>
                        <option value="Acil">Acil</option>
                    </select>
                    <span asp-validation-for="Oncelik" class="text-danger small"></span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label asp-for="PlanlananTarih" class="form-label fw-bold">Planlanan Tarih <span class="text-danger">*</span></label>
                    <input asp-for="PlanlananTarih" type="date" class="form-control" />
                    <span asp-validation-for="PlanlananTarih" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AtananKullaniciId" class="form-label fw-bold">Saha Personeli Ata</label>
                    <select data-control="select2" asp-for="AtananKullaniciId" asp-items="ViewBag.Personeller" class="form-select">
                        <option value="">-- Sonradan Atanacak --</option>
                    </select>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Aciklama" class="form-label fw-bold">Açıklama / Notlar</label>
                <textarea asp-for="Aciklama" class="form-control" rows="3" placeholder="İş emri ile ilgili eklemek istediğiniz notları veya gerekçeyi buraya yazabilirsiniz..."></textarea>
            </div>

            <div class="d-flex justify-content-end pt-3 border-top mt-4">
                <a href="/IsEmri" class="btn btn-light me-2">İptal</a>
                <button type="submit" class="btn btn-primary px-4 fw-bold">
                    <i class="bi bi-save me-2"></i> Kaydet ve Oluştur
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>

        document.addEventListener('DOMContentLoaded', function () {
            if (!window.jQuery || !$.fn.select2) {
                return;
            }

            const $tuketimNoktasi = $('#TuketimNoktasiId');
            const $sozlesme = $('#SozlesmeId');
            const $sayac = $('#SayacId');
            const secimMesaj = document.getElementById('secimMesaj');

            function setMessage(message, className) {
                secimMesaj.textContent = message || '';
                secimMesaj.className = className || 'text-muted';
            }

            function select2Language() {
                return {
                    inputTooShort: function () { return 'Aramak için en az 2 karakter yazın'; },
                    noResults: function () { return 'Kayıt bulunamadı'; },
                    searching: function () { return 'Aranıyor...'; }
                };
            }

            function initAjaxSelect($element, url, placeholder, minimumInputLength, dataBuilder) {
                $element.select2({
                    ajax: {
                        url: url,
                        dataType: 'json',
                        delay: 300,
                        data: function (params) {
                            const payload = dataBuilder ? dataBuilder(params) : {};
                            payload.q = params.term || '';
                            return payload;
                        },
                        processResults: function (data) {
                            return data;
                        }
                    },
                    allowClear: true,
                    minimumInputLength: minimumInputLength,
                    placeholder: placeholder,
                    width: '100%',
                    language: select2Language()
                });
            }

            function setSelectOption($select, id, text) {
                if (!id) {
                    clearSelect($select);
                    return;
                }

                const value = id.toString();
                $select.find('option').filter(function () {
                    return this.value === value;
                }).remove();
                $select.append(new Option(text || value, value, true, true)).trigger('change.select2');
            }

            function clearSelect($select) {
                $select.val(null).trigger('change.select2');
            }

            function loadSecimBilgisi(params) {
                setMessage('Seçim bilgileri getiriliyor...', 'text-muted');

                $.getJSON('/IsEmri/SecimBilgisi', params)
                    .done(function (data) {
                        if (!data || !data.basarili) {
                            setMessage((data && data.mesaj) || 'Seçim bilgisi alınamadı.', 'text-danger');
                            return;
                        }

                        setSelectOption($tuketimNoktasi, data.tuketimNoktasiId, data.tuketimNoktasiText);

                        if (data.sozlesmeId) {
                            setSelectOption($sozlesme, data.sozlesmeId, data.sozlesmeText);
                        } else {
                            clearSelect($sozlesme);
                        }

                        if (data.sayacId) {
                            setSelectOption($sayac, data.sayacId, data.sayacText);
                        } else {
                            clearSelect($sayac);
                        }

                        setMessage(data.mesaj || '', data.mesaj ? 'text-warning' : 'text-muted');
                    })
                    .fail(function () {
                        setMessage('Seçim bilgileri alınırken hata oluştu.', 'text-danger');
                    });
            }

            initAjaxSelect($tuketimNoktasi, '/IsEmri/TuketimNoktasiAra', 'TK kodu veya adres yazın...', 2);
            initAjaxSelect($sozlesme, '/IsEmri/SozlesmeAra', 'Sözleşme no veya TK kodu yazın...', 2);
            initAjaxSelect($sayac, '/IsEmri/SayacAra', 'Sayaç seri no yazın...', 0, function () {
                const tuketimNoktasiId = $tuketimNoktasi.val();
                return tuketimNoktasiId ? { tuketimNoktasiId: tuketimNoktasiId } : {};
            });

            $tuketimNoktasi.on('select2:select', function (event) {
                loadSecimBilgisi({ tuketimNoktasiId: event.params.data.id });
            });

            $tuketimNoktasi.on('select2:clear', function () {
                clearSelect($sozlesme);
                clearSelect($sayac);
                setMessage('', 'text-muted');
            });

            $sozlesme.on('select2:select', function (event) {
                loadSecimBilgisi({ sozlesmeId: event.params.data.id });
            });

            $sayac.on('select2:select', function (event) {
                const data = event.params.data;
                const params = { sayacId: data.id };

                if (data.tuketimNoktasiId) {
                    params.tuketimNoktasiId = data.tuketimNoktasiId;
                }

                loadSecimBilgisi(params);

            });
        });
    </script>
}
