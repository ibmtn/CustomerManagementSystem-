@model KcetasWeb.Models.TuketimNoktasi

@{
    ViewData["Title"] = "Tüketici ve Tesisat Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="mb-3">
            <a href="/TuketimNoktasi/Detay/@Model.tekil_kod" class="btn btn-sm btn-outline-secondary">&larr; Detaya Geri Dön</a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark py-3">
                <h5 class="card-title mb-0 fw-bold">Tüketici ve Tesisat Bilgilerini Düzenle</h5>
            </div>
            <div class="card-body p-4">
                <form action="/TuketimNoktasi/Duzenle" method="post">
                    <!-- Gizli ID Alaný -->
                    <input type="hidden" name="tekil_kod" value="@Model.tekil_kod" />



                    <!-- Tesisat Bilgileri -->
                    <h5 class="text-warning border-bottom pb-2 mb-3 mt-4"><i class="bi bi-house-door"></i> Tesisat ve Adres Bilgileri</h5>
                    <div class="row mb-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Ýl <span class="text-danger">*</span></label>
                            <select data-control="select2" class="form-select bg-light" name="il_adi" id="ilSelect" readonly style="pointer-events: none;">
                                <option value="Kayseri" selected>Kayseri</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Ýlçe Seçiniz <span class="text-danger">*</span></label>
                            <select data-control="select2" class="form-select" name="ilce_id" id="ilceSelect" required>
                                <option value="">Önce Ýl Seçin</option>
                            </select>
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label fw-bold">Bina No</label>
                            <input type="text" class="form-control" name="bina_no" value="@Model.bina_no" />
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label fw-bold">Daire No</label>
                            <input type="text" class="form-control" name="bagimsiz_bolum_no" value="@Model.bagimsiz_bolum_no" />
                        </div>
                        
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">Açýk Adres</label>
                            <textarea class="form-control" name="acik_adres" rows="2">@Model.acik_adres</textarea>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Tüketici Grubu</label>
                            <select data-control="select2" class="form-select" name="tuketici_grubu" required>
                                <option value="MESKEN" selected="@(Model.tuketici_grubu == "MESKEN" || Model.tuketici_grubu == "Mesken")">MESKEN</option>
                                <option value="TÝCARETHANE" selected="@(Model.tuketici_grubu == "TÝCARETHANE" || Model.tuketici_grubu == "Ticarethane")">TÝCARETHANE</option>
                                <option value="SANAYÝ" selected="@(Model.tuketici_grubu == "SANAYÝ" || Model.tuketici_grubu == "Sanayi")">SANAYÝ</option>
                                <option value="TARIMSAL SULAMA" selected="@(Model.tuketici_grubu == "TARIMSAL SULAMA" || Model.tuketici_grubu == "Tarýmsal Sulama")">TARIMSAL SULAMA</option>
                                <option value="AYDINLATMA" selected="@(Model.tuketici_grubu == "AYDINLATMA" || Model.tuketici_grubu == "Aydýnlatma")">AYDINLATMA</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Durum</label>
                            <select data-control="select2" class="form-select" name="status">
                                <option value="Baðlý" selected="@(Model.status == "Baðlý" || Model.baglanti_durumu == KcetasWeb.Models.Enums.BaglantiDurumu.Aktif)">Baðlý</option>
                                <option value="Kesik" selected="@(Model.status == "Kesik" || Model.baglanti_durumu == KcetasWeb.Models.Enums.BaglantiDurumu.Pasif)">Kesik</option>
                            </select>
                        </div>

                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">Baðlantý Gücü (kW)</label>
                            <input type="number" step="0.01" class="form-control" name="baglanti_gucu_kw" value="@Model.baglanti_gucu_kw" />
                        </div>
                    </div>

                    <hr class="text-muted mb-4">

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/TuketimNoktasi/Detay/@Model.tekil_kod" class="btn btn-light border">Ýptal</a>
                        <button type="submit" class="btn btn-warning px-4 fw-bold shadow-sm">Deðiþiklikleri Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const kayseriIlceler = {
            "1": "Melikgazi", "2": "Kocasinan", "3": "Talas", "4": "Akkýþla", 
            "5": "Bünyan", "6": "Develi", "7": "Felahiye", "8": "Hacýlar",
            "9": "Ýncesu", "10": "Özvatan", "11": "Pýnarbaþý", "12": "Sarýoðlan",
            "13": "Sarýz", "14": "Tomarza", "15": "Yahyalý", "16": "Yeþilhisar"
        };



        var currentIl = "Kayseri";
        var currentIlce = "@Model.ilce_id";

        document.addEventListener("DOMContentLoaded", function() {
            ilceDoldur(true);
        });

        function ilceDoldur(isInitialLoad = false) {
            var ilAd = document.getElementById("ilSelect").value;
            var ilceSelect = document.getElementById("ilceSelect");
            
            ilceSelect.innerHTML = '<option value="">Ýlçe Seçin</option>';

            if (ilAd === "Kayseri") {
                Object.keys(kayseriIlceler).forEach(function(id) {
                    var option = document.createElement("option");
                    option.value = id;
                    option.text = id + " - " + kayseriIlceler[id];
                    if (isInitialLoad && id == currentIlce) option.selected = true;
                    ilceSelect.appendChild(option);
                });
            } else if (ilAd) {
                var option = document.createElement("option");
                option.value = "99";
                option.text = "Merkez Ýlçe";
                if (isInitialLoad && "99" == currentIlce) option.selected = true;
                ilceSelect.appendChild(option);
            }
        }
    </script>
}

