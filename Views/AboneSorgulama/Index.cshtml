@{
    ViewData["Title"] = "Abone Sorgulama";
}

<div class="container-fluid mt-3">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h3 mb-0 text-gray-800 fw-bold">
                <i class="bi bi-search text-primary me-2"></i> Abone Sorgulama
            </h2>
            <p class="text-muted mt-1 mb-0">Sistemde kayıtlı aboneleri TCKN, VKN, Abone No veya İsim ile arayın.</p>
        </div>
    </div>

    <!-- Search Card -->
    <div class="card shadow-sm border-0 mb-4 rounded-4">
        <div class="card-body p-4 bg-light rounded-4">
            <form id="searchForm" onsubmit="event.preventDefault(); startSearch();">
                <div class="row g-3 align-items-center">
                    <div class="col-md-10">
                        <div class="input-group input-group-lg shadow-sm rounded-3">
                            <span class="input-group-text bg-white border-end-0 text-primary">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" class="form-control border-start-0 ps-0" 
                                   id="searchInput"
                                   name="q" 
                                   placeholder="TCKN / VKN, Abone No veya Ad Soyad giriniz..." 
                                   value="@ViewBag.Query" 
                                   autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm rounded-3 fw-bold">
                            Sorgula
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Results Section -->
    <div id="noResults" class="alert alert-warning shadow-sm border-0 d-flex align-items-center rounded-3 p-4" role="alert" style="display: none !important;">
        <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
        <div>
            <h5 class="alert-heading fw-bold mb-1">Kayıt Bulunamadı</h5>
            <p class="mb-0">Aramanıza uygun herhangi bir abone sistemde bulunamadı. Lütfen arama kriterlerinizi kontrol edip tekrar deneyin.</p>
        </div>
    </div>

    <div id="resultsCard" class="card shadow border-0 rounded-4" style="display: none;">
        <div class="card-header bg-white py-3 d-flex align-items-center border-bottom-0">
            <h6 class="m-0 font-weight-bold text-success" id="resultCountHeader">
                <i class="bi bi-check-circle-fill me-2"></i> <span id="totalItemsCount">0</span> Kayıt Bulundu
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Abone No</th>
                            <th>Ad Soyad / Unvan</th>
                            <th>TCKN / VKN</th>
                            <th>Tip</th>
                            <th>Durum</th>
                            <th class="text-end pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="resultsTableBody">
                        <!-- Sonuçlar buraya eklenecek -->
                    </tbody>
                </table>
            </div>
            
            <!-- Loading Indicator & Sentinel -->
            <div id="loadingIndicator" class="text-center py-4">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Yükleniyor...</span>
                </div>
                <div class="text-muted mt-2 small fw-bold">Kayıtlar yükleniyor...</div>
            </div>
            <div id="scrollSentinel" style="height: 20px;"></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentPage = 1;
    let currentQuery = '@Html.Raw(ViewBag.Query ?? "")';
    let isLoading = false;
    let hasMorePages = true;
    let observer;

    document.addEventListener("DOMContentLoaded", function() {
        if (currentQuery) {
            startSearch();
        }
        setupIntersectionObserver();
    });

    function startSearch() {
        const q = document.getElementById('searchInput').value;
        currentQuery = q;
        currentPage = 1;
        hasMorePages = true;
        
        document.getElementById('resultsTableBody').innerHTML = '';
        document.getElementById('noResults').style.setProperty("display", "none", "important");
        document.getElementById('resultsCard').style.display = 'none';
        
        if (!q || q.trim() === '') return;
        
        loadData();
    }

    async function loadData() {
        if (isLoading || !hasMorePages) return;
        isLoading = true;
        document.getElementById('loadingIndicator').style.display = 'block';

        try {
            const response = await fetch(`/AboneSorgulama/SearchData?q=${encodeURIComponent(currentQuery)}&page=${currentPage}&pageSize=50`);
            const json = await response.json();
            
            if (currentPage === 1) {
                if (json.totalItems === 0) {
                    document.getElementById('noResults').style.setProperty("display", "flex", "important");
                    document.getElementById('resultsCard').style.display = 'none';
                } else {
                    document.getElementById('noResults').style.setProperty("display", "none", "important");
                    document.getElementById('resultsCard').style.display = 'block';
                    document.getElementById('totalItemsCount').textContent = json.totalItems;
                }
            }

            if (json.data && json.data.length > 0) {
                appendRows(json.data);
            }

            if (currentPage >= json.totalPages) {
                hasMorePages = false;
            } else {
                currentPage++;
            }
        } catch (error) {
            console.error("Veri çekilirken hata oluştu:", error);
        } finally {
            isLoading = false;
            if (!hasMorePages) {
                document.getElementById('loadingIndicator').style.display = 'none';
            }
        }
    }

    function appendRows(data) {
        const tbody = document.getElementById('resultsTableBody');
        
        data.forEach(abone => {
            const tr = document.createElement('tr');
            
            const isKurumsal = abone.abone_tipi === 2; // Assuming 2 is Kurumsal in Enums
            const adSoyadUnvan = isKurumsal ? (abone.unvan || '') : `${abone.ad || ''} ${abone.soyad || ''}`;
            const kimlik = isKurumsal ? (abone.vkn || '') : (abone.tckn || '');
            
            const tipBadge = isKurumsal 
                ? `<span class="badge bg-warning bg-opacity-10 text-warning border border-warning rounded-pill px-3">KURUMSAL</span>`
                : `<span class="badge bg-info bg-opacity-10 text-info border border-info rounded-pill px-3">BİREYSEL</span>`;
                
            const durumBadge = abone.durum === "Aktif"
                ? `<span class="badge bg-success rounded-pill px-3">Aktif</span>`
                : `<span class="badge bg-danger rounded-pill px-3">Pasif</span>`;

            tr.innerHTML = `
                <td class="ps-4"><strong>${abone.abone_no || ''}</strong></td>
                <td>
                    <div class="d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 40px; height: 40px;">
                            <i class="bi bi-person-fill"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">${adSoyadUnvan}</h6>
                            <small class="text-muted"><i class="bi bi-telephone-fill me-1"></i> ${abone.telefon || ''}</small>
                        </div>
                    </div>
                </td>
                <td><span class="font-monospace text-muted">${kimlik}</span></td>
                <td>${tipBadge}</td>
                <td>${durumBadge}</td>
                <td class="text-end pe-4">
                    <a href="/AboneSorgulama/Detay/${abone.abone_id}" class="btn btn-sm btn-outline-primary shadow-sm rounded-pill px-3">Detay Görüntüle</a>
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    function setupIntersectionObserver() {
        const sentinel = document.getElementById('scrollSentinel');
        
        const options = {
            root: null,
            rootMargin: '100px',
            threshold: 0.1
        };

        observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting && !isLoading && hasMorePages && currentQuery) {
                    loadData();
                }
            });
        }, options);

        observer.observe(sentinel);
    }
</script>
}

