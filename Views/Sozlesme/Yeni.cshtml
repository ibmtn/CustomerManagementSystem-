@model KcetasWeb.ViewModels.SozlesmeViewModels
@{
    ViewData["Title"] = "Yeni Sözleşme";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="mb-3">
            <a href="/Sozlesme" class="btn btn-sm btn-outline-secondary">&larr; Listeye Geri Dön</a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="card-title mb-0 fw-bold">Yeni Perakende Satış Sözleşmesi Ekle</h5>
            </div>
            <div class="card-body p-4">
                <form action="/Sozlesme/Yeni" method="post">
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger mb-4 shadow-sm border-0 border-start border-danger border-4">
                            <div class="fw-bold mb-1"><i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i> Kayıt Başarısız:</div>
                            <ul class="mb-0 mt-2">
                                @foreach (var key in ViewData.ModelState.Keys)
                                {
                                    foreach (var error in ViewData.ModelState[key].Errors)
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                }
                            </ul>
                        </div>
                    }

                    <h6 class="fw-bold text-primary border-bottom pb-2 mb-3 mt-2">1. Sözleşme ve Tesisat Bilgileri</h6>
                    <div class="row mb-3">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Tüketim Noktası (Tesisat) <span class="text-danger">*</span></label>
                            <select class="form-select" name="tuketim_noktasi_id" id="TuketimNoktasiId" required>
                                <option value="">TK kodu veya adres yazın...</option>
                                @if (Model?.tuketim_noktasi_id > 0 && ViewBag.SelectedTuketimNoktasiText != null)
                                {
                                    <option value="@Model.tuketim_noktasi_id" selected>@ViewBag.SelectedTuketimNoktasiText</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Abone (Müşteri) <span class="text-danger">*</span></label>
                            <select class="form-select" name="abone_id" id="AboneId" required>
                                <option value="">Müşteri adı, kimlik no veya telefon yazın...</option>
                                @if (Model?.abone_id > 0 && ViewBag.SelectedAboneText != null)
                                {
                                    <option value="@Model.abone_id" selected>@ViewBag.SelectedAboneText</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Sözleşme Tipi <span class="text-danger">*</span></label>
                            <select data-control="select2" class="form-select" name="sozlesme_tipi" required>
                                <option value="Bireysel">Bireysel</option>
                                <option value="Kurumsal">Kurumsal</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Tarife Grubu <span class="text-danger">*</span></label>
                            <select data-control="select2" class="form-select" name="tarife_id" required>
                                <option value="" disabled selected>Seçiniz</option>
                                <option value="1">1 - Mesken</option>
                                <option value="3">3 - Ticarethane</option>
                                <option value="2">2 - Sanayi</option>
                                <option value="4">4 - Tarımsal Sulama</option>
                                <option value="5">5 - Aydınlatma</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Güvence Bedeli (TL)</label>
                            <input type="number" step="0.01" class="form-control" name="guvence_bedeli" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Ödeme Şekli <span class="text-danger">*</span></label>
                            <select data-control="select2" class="form-select" name="odeme_sekli" required>
                                <option value="Nakit">Nakit</option>
                                <option value="Kredi Kartı">Kredi Kartı</option>
                                <option value="Havale/EFT">Havale/EFT</option>
                            </select>
                        </div>
                    </div>

                    <hr class="text-muted mb-4">

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/Sozlesme" class="btn btn-light border">İptal</a>
                        <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">Sözleşmeyi Oluştur</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            if (!window.jQuery || !$.fn.select2) {
                return;
            }

            function select2Language() {
                return {
                    inputTooShort: function () { return 'Aramak için en az 2 karakter yazın'; },
                    noResults: function () { return 'Kayıt bulunamadı'; },
                    searching: function () { return 'Aranıyor...'; }
                };
            }

            function initAjaxSelect($element, url, placeholder) {
                $element.select2({
                    ajax: {
                        url: url,
                        dataType: 'json',
                        delay: 300,
                        cache: true,
                        data: function (params) {
                            return { q: params.term || '' };
                        },
                        processResults: function (data) {
                            return data;
                        }
                    },
                    allowClear: true,
                    minimumInputLength: 2,
                    placeholder: placeholder,
                    width: '100%',
                    language: select2Language()
                });
            }

            initAjaxSelect($('#TuketimNoktasiId'), '/Sozlesme/TuketimNoktasiAra', 'TK kodu veya adres yazın...');
            initAjaxSelect($('#AboneId'), '/Sozlesme/AboneAra', 'Müşteri adı, kimlik no veya telefon yazın...');
        });
    </script>
}
